# Disease Detective — Environment Configuration
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_SJQOP4pslu7N@ep-orange-base-ahwnj8uy-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── External API Keys ────────────────────────────────────────────────
CDC_APP_TOKEN=
CENSUS_API_KEY=
NOAA_TOKEN=
# Get CDC token: https://data.cdc.gov/profile/edit/developer_settings
# Get Census key: https://api.census.gov/data/key_signup.html
# Get NOAA token: https://www.ncdc.noaa.gov/cdo-web/token

# ── ML Model ─────────────────────────────────────────────────────────
MODEL_PATH=models/best_influenza_lstm_classifier.pth
MODEL_DEVICE=cpu

# ── Security ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
